# ==============================================================================
# BARAKAH AGRO - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' in your local root directory before running:
# cp .env.example .env
#
# NOTE: Never commit your actual '.env' file with real credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. FIREBASE FIRESTORE CONFIGURATION (Client-Side Vite variables)
# ------------------------------------------------------------------------------
# Get these values from your Firebase Console:
# Project Settings -> General -> Your apps -> Web app (SDK setup and configuration)
VITE_FIREBASE_API_KEY="your-firebase-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
# Leave '(default)' unless you created a named Firestore database instance
VITE_FIREBASE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 3. ADMIN AUTHENTICATION (Optional local override)
# ------------------------------------------------------------------------------
# Default admin account email configured in the database is:
# tahminajannatayesha@gmail.com (or admin@barakahagro.com)
# Default password: barakah2026 (changeable in the admin panel)
ADMIN_SECRET_PIN="barakah2026"

# ------------------------------------------------------------------------------
# 4. OPTIONAL AI & ANALYTICS KEYS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
