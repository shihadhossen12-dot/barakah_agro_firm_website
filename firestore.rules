rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products: public can read active non-archived items, admin can write
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories: public can read, admin can write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: public can create order and read their order, admin can manage
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if true;
    }

    // Customers: read and write
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Site Settings: public can read, admin can write
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews: public can read and submit
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Coupons: public read, admin write
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if true;
    }
  }
}
